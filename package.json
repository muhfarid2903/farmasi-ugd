{
  "name": "farmasi-ugd",
  "private": true,
  "version": "1.0.0",
  "description": "e-Stok UGD: catatan stok obat & bahan medis UGD Puskesmas Liukang Tupabbiring",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "seed": "node scripts/seed.mjs",
    "icons": "pwa-assets-generator",
    "test:rules": "firebase emulators:exec --only firestore --project farmasi-ugd-test \"vitest run --config vitest.rules.config.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "add-user": "node scripts/add-user.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
